rules_version = '2';

// Splyce live-splitting security rules (Stage 1 MVP).
//
// Model:
//   - The HOST authenticates anonymously (see src/services/firebase.ts
//     ensureHostId). Their auth uid is stored as the session's hostId.
//   - GUESTS are unauthenticated. They can read a session by id and add/update
//     their claims, but nothing else.
//
// This is intentionally simple, but not wide open: guest writes may only touch
// the `items` and `guests` fields, and may not reopen/hijack the session or
// tamper with host/receipt metadata.

service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {

      // The host owns the session when their uid matches the stored hostId.
      function isHost() {
        return request.auth != null && request.auth.uid == resource.data.hostId;
      }

      // Fields a non-host (guest) write is allowed to modify.
      function onlyClaimFieldsChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['items', 'guests']);
      }

      // A session is live only until its expiresAt deadline. Guest writes
      // (claims/joins) are rejected server-side once it passes, so a client that
      // bypasses the UI still can't mutate an expired session. request.time is
      // the server's clock, so this can't be spoofed by the caller. Sessions
      // with no expiresAt (should not exist, but be safe) are treated as live.
      function notExpired() {
        return !('expiresAt' in resource.data)
               || resource.data.expiresAt == null
               || request.time < resource.data.expiresAt;
      }

      // Anyone who knows the sessionId can read it (guests aren't authed).
      allow read: if true;

      // Create: must be an authenticated host creating an OPEN session whose
      // hostId is their own uid. Prevents spoofing someone else as host.
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.status == 'open';

      // Update:
      //  - The host may update anything on their own session (incl. status),
      //    even past expiry, so they can still close/finalize an expired split.
      //  - A guest may update ONLY items/guests, and only while the session is
      //    open, stays open, and hasn't expired (can't flip status, change
      //    host, receipt, or touch a session past its deadline).
      allow update: if isHost()
                    || (
                         resource.data.status == 'open'
                         && request.resource.data.status == 'open'
                         && notExpired()
                         && onlyClaimFieldsChanged()
                       );

      // Only the host may delete the session.
      allow delete: if isHost();
    }

    // Free-tier scan counting: one doc per user at usage/{uid}, keyed by their
    // anonymous auth uid, holding only { scanCount, monthKey }. A user may
    // read/write only their own doc. Unlock status is NOT here — it's RevenueCat's
    // server-validated "Splyce Pro" entitlement, so tampering with this doc only
    // affects the free-tier counter, never the paid unlock.
    match /usage/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validShape() {
        return request.resource.data.keys().hasOnly(['scanCount', 'monthKey'])
               && request.resource.data.scanCount is int
               && request.resource.data.monthKey is string;
      }

      allow read: if isOwner();

      // A brand-new doc must start the count at exactly 1 (recordScan's first
      // call for this user/month) — never an arbitrary or negative value.
      allow create: if isOwner() && validShape() && request.resource.data.scanCount == 1;

      // Writes may only move the count forward by exactly 1 within the same
      // month, or reset to 1 on a month rollover — never jump to an arbitrary
      // value (e.g. back to 0) to dodge the paywall. Note: rules can't format
      // request.time into a "YYYY-MM" string, so this can't verify monthKey
      // against the real server month, only that old/new values are internally
      // consistent — full protection against monthKey spoofing needs the
      // increment to move server-side.
      allow update: if isOwner() && validShape() &&
                    (
                      (request.resource.data.monthKey == resource.data.monthKey
                       && request.resource.data.scanCount == resource.data.scanCount + 1)
                      ||
                      (request.resource.data.monthKey != resource.data.monthKey
                       && request.resource.data.scanCount == 1)
                    );

      allow delete: if false;
    }
  }
}
